# ==========================================================
# Flutter Build Configuration Variables
# Used by scripts/build-client.sh
# ==========================================================

# ----------------------------------------
# 1. LOCAL ENVIRONMENT
# Tested using local emulators or browser
# ----------------------------------------
LOCAL_API_BASE_URL="http://localhost:8081"
LOCAL_HLS_URL="http://localhost:8082/hls/stream.m3u8"
LOCAL_ENABLE_LIVE_STREAM="true"
LOCAL_REFRESH_SECONDS=5
LOCAL_PREVIEW_PORT=8090

# ----------------------------------------
# 2. K8S ENVIRONMENT
# Deployed via ArgoCD on proxmox-k8s cluster
# ----------------------------------------
K8S_API_BASE_URL="http://streamer.homelab.local"
K8S_HLS_URL="http://streamer.homelab.local/live/stream.m3u8"
K8S_ENABLE_LIVE_STREAM="true"
K8S_REFRESH_SECONDS=5
